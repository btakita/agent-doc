#!/bin/sh
# `#testisolationtests`: refuse a test TMPDIR that sits inside an agent-doc
# project, and print the ceiling list tests must run under.
#
# A test whose TMPDIR is under a directory holding `.agent-doc/` (typically
# `$HOME`, whose `~/.agent-doc` is the operator's real user-level state) walks
# up from its tempdir, adopts that directory as its project root, and writes
# the operator's state.db / ops.log / snapshots / proof ledger and spawns
# controllers there. Discovery is bounded by AGENT_DOC_ROOT_CEILING_DIRECTORIES
# (GIT_CEILING_DIRECTORIES semantics); this guard refuses the unsafe TMPDIR
# outright so the bound is never the only line of defence.
#
# Usage:
#   scripts/check-test-tmpdir [TMPDIR]        print the ceiling list or exit 1
#   scripts/check-test-tmpdir --nextest-env   nextest setup script: also write the
#                                             ceiling into "$NEXTEST_ENV"
set -eu

nextest_env=0
if [ "${1:-}" = "--nextest-env" ]; then
    nextest_env=1
    shift
fi

dir=${1:-${TMPDIR:-/tmp}}
case "$dir" in
    /*) ;;
    *) dir="$PWD/$dir" ;;
esac
mkdir -p "$dir"
canonical=$(cd "$dir" && pwd -P)

probe=$canonical
while :; do
    if [ -d "$probe/.agent-doc" ]; then
        echo "error: test TMPDIR $canonical is inside the agent-doc project $probe ($probe/.agent-doc)." >&2
        echo "error: tests would walk up and write that project's real state; use a TMPDIR outside any .agent-doc tree, e.g. TMPDIR=/tmp/agent-doc-test (#testisolationtests)" >&2
        exit 1
    fi
    [ "$probe" = "/" ] && break
    probe=$(dirname "$probe")
done

# Bound discovery at the test temp root and the workspace the tests run from.
# An explicit ceiling (Makefile export, operator override) is kept, but it can
# never drop THIS checkout's bounds (`#checktmpdirleak`): an inherited list may
# have been exported by a different checkout's `make` (an agent shell, a tmux
# server, or a nested run started there), and honoring it verbatim left this
# workspace unbounded -- discovery could climb out of it to `$HOME/.agent-doc`
# -- while the setup step printed the other checkout's path. Missing entries
# are appended; extra entries only narrow discovery further.
workspace=$(pwd -P)
ceiling=${AGENT_DOC_ROOT_CEILING_DIRECTORIES-}
for required in "$canonical" "$workspace"; do
    case ":$ceiling:" in
        *":$required:"*) ;;
        *) ceiling=${ceiling:+$ceiling:}$required ;;
    esac
done

# `#testisolationleaks`: the test runtime scope. Test binaries already scope
# themselves to their temp dir; exporting it also confines the `agent-doc`
# binaries an integration test spawns, so no test process -- harness or child --
# can discover, signal, or write a live project's controller, supervisors,
# sockets, or state.db.
if [ "$nextest_env" = 1 ]; then
    : "${NEXTEST_ENV:?--nextest-env must run as a nextest setup script}"
    printf 'AGENT_DOC_ROOT_CEILING_DIRECTORIES=%s\n' "$ceiling" >>"$NEXTEST_ENV"
    printf 'AGENT_DOC_TEST_RUNTIME_SCOPE=%s\n' "$canonical" >>"$NEXTEST_ENV"
fi
printf '%s\n' "$ceiling"
