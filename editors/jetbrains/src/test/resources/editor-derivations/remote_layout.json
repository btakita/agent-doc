{
  "derivation": "remote_layout",
  "about": "GH #326/#343 compatibility contract. Legacy flat visible, selected, and open lists carry focus only. They never create pane membership or order; without a cached exact frontend snapshot every step is structurally unknown.",
  "cases": [
    {
      "name": "one client visible set is not column geometry",
      "steps": [
        {
          "input": {
            "project_root": "/repo",
            "clients": [{
              "visible": ["tasks/left.md", "tasks/right.md"],
              "selected": ["tasks/left.md"],
              "open": ["tasks/left.md", "tasks/right.md"]
            }],
            "focused": ["tasks/left.md"]
          },
          "expected": {
            "columns": [],
            "source": "unknown",
            "column_order": "unknown",
            "reason": "flat_evidence_has_no_column_geometry"
          }
        }
      ]
    },
    {
      "name": "multi-selection is focus evidence not columns",
      "steps": [
        {
          "input": {
            "project_root": "/repo",
            "clients": [{
              "visible": [],
              "selected": ["tasks/laptop.md", "tasks/1099.md", "tasks/laptop.md"],
              "open": ["tasks/laptop.md", "tasks/1099.md"]
            }],
            "focused": ["tasks/laptop.md"]
          },
          "expected": {
            "columns": [],
            "source": "unknown",
            "column_order": "unknown",
            "reason": "flat_evidence_has_no_column_geometry"
          }
        }
      ]
    },
    {
      "name": "one focused file is structurally unknown",
