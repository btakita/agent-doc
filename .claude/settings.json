{
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent-doc hook coined-id-pre-tool-use",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agent-doc turn-status idle",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "agent-doc turn-status idle",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "agent-doc hook claude-stop",
            "statusMessage": "Checking agent-doc queue continuation",
            "timeout": 15,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "agent-doc turn-status active",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "agent-doc hook preflight-user-prompt-submit",
            "timeout": 120,
            "type": "command"
          }
        ]
      }
    ]
  }
}
