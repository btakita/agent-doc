        "canonical_equals_shadow": false,
        "canonical_contains_operator_edits": null,
        "clean_merge_available": null
      },
      "expected": {
        "action": "hold_operator_buffer",
        "hold_reason": "retained-reseed-missing-settled-shadow"
      }
    },
