#!/usr/bin/env python3
"""Dogfood watcher: turn live agent-doc session logs into backlog + queue items.

Watches every running `agent-doc start` supervisor (or only documents named on
the command line), asks the binary to resolve each source document's typed
dogfood policy and classify each project's `ops.log`, then files anything new
into the resolved target. `auto: false` stops at backlog; `auto: true` marks the
generated item for queue sync.

Deliberately thin: all log classification is `agent-doc ops summary --json`, and
all document mutation is `agent-doc backlog <doc> add` / `agent-doc queue sync`.
No document parsing or writing happens here -- per src/agent-doc/AGENTS.md,
deterministic document logic lives in the binary, never in a script.

Usage:
  bin/agent-doc-dogfood-watch --once --dry-run
  bin/agent-doc-dogfood-watch --interval 300
  bin/agent-doc-dogfood-watch --doc src/haiven-dev/tasks/haiven-dev.md --once
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
STATE_PATH = REPO_ROOT / ".agent-doc/dogfood-watch-state.json"

SEVERITY_ORDER = {"low": 0, "medium": 1, "high": 2, "critical": 3}

# Supervisor stderr is not covered by `ops summary`; these are the shapes worth
# filing when they show up there.
STDERR_SIGNATURES = [
    (re.compile(r"thread '.*' panicked at"), "supervisor panic", "critical"),
    (re.compile(r"\bfatal runtime error\b"), "supervisor runtime abort", "critical"),
    (
        re.compile(
            r"\bSIGKILL\b|\bkilled\b.*out of memory|\bOut of memory\b", re.IGNORECASE
        ),
        "supervisor OOM/kill",
        "critical",
    ),
    (re.compile(r"^error: "), "supervisor error", "high"),
]


@dataclass(frozen=True)
class DogfoodPolicy:
    """Binary-resolved routing policy for one source session."""

    enabled: bool
    source_document: Path
    target: Path | None
    self_target: bool
    auto: bool


def run(cmd: list[str], cwd: Path | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        cmd,
        cwd=str(cwd) if cwd else None,
        capture_output=True,
        text=True,
        check=False,
    )


def find_project_root(doc: Path) -> Path | None:
    """Nearest ancestor holding a `.agent-doc/` directory."""
    for candidate in [doc.parent, *doc.parent.parents]:
        if (candidate / ".agent-doc").is_dir():
            return candidate
    return None


def dogfood_policy(doc: Path) -> DogfoodPolicy | None:
    """Ask the binary for the typed session/project policy; fail closed."""
    proc = run(["agent-doc", "dogfood", "policy", str(doc), "--json"])
    if proc.returncode != 0:
        print(
            f"[skip] dogfood policy unavailable for {doc}: {proc.stderr.strip()}",
            file=sys.stderr,
        )
        return None
    try:
        value = json.loads(proc.stdout)
        enabled = value["enabled"]
        self_target = value["self_target"]
        auto = value["auto"]
        if not all(isinstance(flag, bool) for flag in (enabled, self_target, auto)):
            raise TypeError("enabled/self_target/auto must be booleans")
        source = Path(value["source_document"]).resolve()
        target_value = value.get("target")
        target = Path(target_value).resolve() if target_value is not None else None
        if enabled and target is None:
            raise ValueError("enabled policy has no target")
        if not enabled and target is not None:
            raise ValueError("disabled policy unexpectedly has a target")
        return DogfoodPolicy(enabled, source, target, self_target, auto)
    except (KeyError, TypeError, ValueError, json.JSONDecodeError) as exc:
        print(f"[skip] invalid dogfood policy for {doc}: {exc}", file=sys.stderr)
        return None


def live_session_docs() -> list[Path]:
    """Documents owned by a running `agent-doc start` supervisor.

    Supervisors are commonly started with a document path relative to their own
    working directory (`agent-doc start tasks/sdk.md`), and that directory is
    frequently a submodule rather than this repo root -- so resolve each relative
    path against `/proc/<pid>/cwd`, not against `REPO_ROOT`.
    """
    proc = run(["ps", "-eo", "pid=,args="])
    docs: list[Path] = []
    for line in proc.stdout.splitlines():
        line = line.strip()
        if "agent-doc start" not in line:
            continue
        pid, _, args = line.partition(" ")
        if not pid.isdigit():
            continue
        try:
            cwd = Path(os.readlink(f"/proc/{pid}/cwd"))
        except OSError:
            cwd = REPO_ROOT
        for token in args.split():
            if not token.endswith(".md"):
                continue
            path = Path(token)
            if not path.is_absolute():
                path = cwd / token
            if path.exists():
                docs.append(path.resolve())
    return sorted(set(docs))


def signature_id(family: str, example: str) -> str:
    """Stable per-cluster id so re-runs never file the same finding twice."""
    # Strip volatile ids so the same defect keeps one signature across sessions.
    normalized = re.sub(r"\b(session|cycle|patch|pid|generation)=\S+", "", example)
    normalized = re.sub(r"\b[0-9a-f]{8,}\b", "", normalized)
    normalized = re.sub(r"\d{6,}", "", normalized)
    normalized = " ".join(normalized.split())
    digest = hashlib.sha1(f"{family}|{normalized}".encode()).hexdigest()[:7]
    return f"dfw{digest}"


def cluster_documents(root: Path, cluster: dict, root_docs: list[Path]) -> list[Path]:
    """Attribute a typed cluster to source docs without guessing across files."""
    raw_files = cluster.get("files") or []
    if not raw_files:
        return root_docs
    files = set()
    for raw in raw_files:
        path = Path(raw)
        if not path.is_absolute():
            path = root / path
        files.add(path.resolve())
    return [doc for doc in root_docs if doc.resolve() in files]


def known_ids(target: Path) -> set[str]:
    """Ids already tracked in the target document (open, gated, iceboxed, or done).

    `agent:done` matters as much as `agent:backlog`: a finding that was filed and
    closed must not be re-filed the next time the same line is still in the log
    tail.
    """
    ids: set[str] = set()
    for component in ("backlog", "review", "icebox", "done", "queue"):
        proc = run(["agent-doc", "read", str(target), "--component", component])
        if proc.returncode != 0:
            continue
        ids.update(re.findall(r"\[#([A-Za-z0-9_-]+)\]", proc.stdout))
    return ids


def ops_clusters(root: Path, limit: int) -> list[dict]:
    proc = run(
        [
            "agent-doc",
            "ops",
            "summary",
            "--json",
            "--project-root",
            str(root),
            "--limit",
            str(limit),
        ]
    )
    if proc.returncode != 0 or not proc.stdout.strip():
        return []
    try:
        return json.loads(proc.stdout).get("bug_clusters") or []
    except json.JSONDecodeError:
        return []


def stderr_clusters(root: Path, limit: int) -> list[dict]:
    log = root / ".agent-doc/logs/supervisor-stderr.log"
    if not log.is_file():
        return []
    try:
        lines = log.read_text(errors="ignore").splitlines()[-limit:]
    except OSError:
        return []
    found: dict[str, dict] = {}
    for line in lines:
        for pattern, family, severity in STDERR_SIGNATURES:
            if not pattern.search(line):
                continue
            entry = found.setdefault(
                family,
                {
                    "family": family,
                    "severity": severity,
                    "count": 0,
                    "examples": [],
                    "files": [],
                    "recommendation": "inspect supervisor-stderr.log around this line and fix the crashing path",
                    "source": "supervisor-stderr.log",
                },
            )
            entry["count"] += 1
            if len(entry["examples"]) < 3:
                entry["examples"].append(line.strip()[:400])
            break
    return list(found.values())


def format_item(finding: dict, item_id: str, auto: bool) -> str:
    """One backlog line per defect signature, aggregated across every project it hit.

    The same family shows up in several project roots at once (all the live
    sessions share one binary), so a per-root item would file the same defect
    four times. Aggregate instead and name every affected root/document.
    """
    roots = ", ".join(sorted(finding["roots"]))
    docs = ", ".join(sorted(finding["docs"])) or "(no document attributed)"
    probe_root = min(finding["roots"])
    enqueue = ":inbox_tray: " if auto else ""
    return (
        f"id={item_id} {enqueue}[dogfood] #agent-doc-bug {finding['family']} "
        f"({finding['severity']}, {finding['count']} hits across {len(finding['roots'])} project(s)) "
        f"seen in {roots} via {finding['source']}; documents: {docs}. "
        f"Example: {finding['example']} "
        f"Auto-filed by bin/agent-doc-dogfood-watch. Recommendation: {finding['recommendation']} "
        f"Reproduce with `agent-doc ops summary --project-root {probe_root} --limit 4000` "
        f"and `agent-doc ops diagnose --project-root {probe_root}`."
    )


def load_state() -> dict:
    if STATE_PATH.is_file():
        try:
            return json.loads(STATE_PATH.read_text())
        except (OSError, json.JSONDecodeError):
            pass
    return {"filed": {}}


def save_state(state: dict) -> None:
    STATE_PATH.parent.mkdir(parents=True, exist_ok=True)
    tmp = STATE_PATH.with_name(f".{STATE_PATH.name}.tmp-{os.getpid()}")
    tmp.write_text(json.dumps(state, indent=2, sort_keys=True))
    os.replace(tmp, STATE_PATH)


def guarded_self_write(state: dict, target: Path, cluster: dict) -> bool:
    """Suppress only events timestamped inside this watcher's own write window."""
    guard = state.get("self_target_guard", {}).get(str(target))
    timestamp = cluster.get("latest_timestamp")
    if not isinstance(guard, dict) or not isinstance(timestamp, int):
        return False
    return guard.get("from", timestamp + 1) <= timestamp <= guard.get("through", -1)


def scan_once(args: argparse.Namespace) -> int:
    scan_started = int(time.time())
    docs = [Path(d).resolve() for d in args.doc] or live_session_docs()

    override_target = Path(args.target).resolve() if args.target else None
    policies: dict[Path, DogfoodPolicy] = {}
    for doc in docs:
        policy = dogfood_policy(doc)
        if policy is None or not policy.enabled:
            continue
        if override_target is not None:
            policy = DogfoodPolicy(
                enabled=True,
                source_document=policy.source_document,
                target=override_target,
                self_target=policy.source_document == override_target,
                auto=policy.auto,
            )
        policies[doc] = policy

    roots: dict[Path, list[Path]] = {}
    for doc in policies:
        root = find_project_root(doc)
        if root is None:
            print(f"[skip] no .agent-doc project root for {doc}", file=sys.stderr)
            continue
        roots.setdefault(root, []).append(doc)

    if not roots:
        print("[dogfood] no opted-in agent-doc sessions found", file=sys.stderr)
        return 0

    state = load_state()
    threshold = SEVERITY_ORDER.get(args.min_severity, 2)
    excluded = {f.strip().lower() for f in args.exclude_family}

    # Aggregate by destination and defect signature. The same target can inherit
    # evidence from several source sessions; `auto` is true only when at least
    # one explicitly auto-enabled source contributed that finding.
    findings: dict[Path, dict[str, dict]] = {}
    for root, root_docs in sorted(roots.items()):
        clusters = ops_clusters(root, args.limit) + stderr_clusters(root, args.limit)
        for cluster in clusters:
            family = cluster.get("family", "unknown")
            if family.lower() in excluded:
                continue
            severity = cluster.get("severity", "low")
            if SEVERITY_ORDER.get(severity, 0) < threshold:
                continue
            examples = cluster.get("examples") or []
            example = examples[0] if examples else "(no example line)"
            item_id = signature_id(family, example)
            attributed = cluster_documents(root, cluster, root_docs)
            contributions: dict[Path, list[tuple[Path, DogfoodPolicy]]] = {}
            for doc in attributed:
                policy = policies[doc]
                target = policy.target
                if target is None:
                    continue
                if policy.self_target and guarded_self_write(state, target, cluster):
                    print(
                        f"[guard] ignored self-target event from watcher write window: {target}",
                        file=sys.stderr,
                    )
                    continue
                contributions.setdefault(target, []).append((doc, policy))

            for target, sources in contributions.items():
                target_findings = findings.setdefault(target, {})
                finding = target_findings.setdefault(
                    item_id,
                    {
                        "family": family,
                        "severity": severity,
                        "count": 0,
                        "roots": set(),
                        "docs": set(),
                        "example": example,
                        "source": cluster.get("source", "ops.log"),
                        "recommendation": cluster.get("recommendation")
                        or "triage the cluster in ops.log",
                        "auto": False,
                        "self_target": False,
                        "latest_timestamp": cluster.get("latest_timestamp"),
                    },
                )
                finding["count"] += cluster.get("count", 0)
                finding["roots"].add(str(root))
                finding["docs"].update(str(doc) for doc, _ in sources)
                finding["auto"] = finding["auto"] or any(
                    policy.auto for _, policy in sources
                )
                finding["self_target"] = finding["self_target"] or any(
                    policy.self_target for _, policy in sources
                )
                latest = cluster.get("latest_timestamp")
                if latest is not None and (
                    finding["latest_timestamp"] is None
                    or latest > finding["latest_timestamp"]
                ):
                    finding["latest_timestamp"] = latest
                if SEVERITY_ORDER.get(severity, 0) > SEVERITY_ORDER.get(
                    finding["severity"], 0
                ):
                    finding["severity"] = severity

    filed = 0
    for target, target_findings in sorted(
        findings.items(), key=lambda item: str(item[0])
    ):
        filed_for_target = state.setdefault("filed", {}).setdefault(str(target), {})
        already = known_ids(target) | set(filed_for_target)
        auto_filed = 0
        for item_id, finding in sorted(
            target_findings.items(),
            key=lambda kv: -SEVERITY_ORDER.get(kv[1]["severity"], 0),
        ):
            if item_id in already:
                prior = filed_for_target.get(item_id)
                if (
                    finding["auto"]
                    and isinstance(prior, dict)
                    and not prior.get("auto", False)
                ):
                    text = format_item(finding, item_id, True).removeprefix(
                        f"id={item_id} "
                    )
                    if args.dry_run:
                        print(
                            f"[dry-run] would auto-activate #{item_id} in {target}: {text}"
                        )
                    else:
                        proc = run(
                            ["agent-doc", "backlog", str(target), "edit", item_id, text]
                        )
                        if proc.returncode != 0:
                            print(
                                f"[error] backlog auto-promotion failed for #{item_id}: "
                                f"{proc.stderr.strip()}",
                                file=sys.stderr,
                            )
                            continue
                        prior["auto"] = True
                        prior["auto_promoted_at"] = int(time.time())
                        save_state(state)
                    auto_filed += 1
                continue
            text = format_item(finding, item_id, finding["auto"])
            if args.dry_run:
                print(f"[dry-run] would file #{item_id} in {target}: {text}")
            else:
                proc = run(["agent-doc", "backlog", str(target), "add", text])
                if proc.returncode != 0:
                    print(
                        f"[error] backlog add failed for #{item_id}: {proc.stderr.strip()}",
                        file=sys.stderr,
                    )
                    continue
                print(
                    f"[filed] #{item_id} {finding['family']} "
                    f"({finding['severity']}, {finding['count']} hits) in "
                    f"{len(finding['roots'])} project(s) -> {target}"
                )
                filed_at = int(time.time())
                filed_for_target[item_id] = {
                    "family": finding["family"],
                    "severity": finding["severity"],
                    "roots": sorted(finding["roots"]),
                    "source_documents": sorted(finding["docs"]),
                    "filed_at": filed_at,
                    "auto": finding["auto"],
                }
                if finding["self_target"]:
                    state.setdefault("self_target_guard", {})[str(target)] = {
                        "from": scan_started,
                        "through": filed_at + 1,
                    }
                # Persist the dedupe receipt before a queue activation can emit
                # another event from the self-target document.
                save_state(state)
            already.add(item_id)
            filed += 1
            if finding["auto"]:
                auto_filed += 1

        if auto_filed and not args.dry_run:
            sync = run(["agent-doc", "queue", "sync", str(target)])
            if sync.returncode != 0:
                print(
                    f"[error] queue sync failed for {target}: {sync.stderr.strip()}",
                    file=sys.stderr,
                )
            else:
                print(
                    f"[dogfood] queue activated: {auto_filed} new generated item(s) "
                    f"mirrored into agent:queue for {target}"
                )

    if not filed:
        print("[dogfood] no new issue clusters above threshold")
    return filed


def main() -> int:
    parser = argparse.ArgumentParser(
        description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter
    )
    parser.add_argument(
        "--target",
        help="override the resolved destination for opted-in sessions (does not enable dogfood)",
    )
    parser.add_argument(
        "--doc",
        action="append",
        default=[],
        help="explicit session document to watch (repeatable)",
    )
    parser.add_argument(
        "--all-sessions",
        action="store_true",
        help="compatibility no-op; every live session is considered and typed dogfood policy gates filing",
    )
    parser.add_argument(
        "--limit", type=int, default=4000, help="trailing log lines to scan per project"
    )
    parser.add_argument(
        "--min-severity",
        default="high",
        choices=sorted(SEVERITY_ORDER),
        help="lowest severity to file (default high; medium includes routine guardrail noise such as commit_noop)",
    )
    parser.add_argument(
        "--exclude-family",
        action="append",
        default=[],
        help="cluster family to never file (repeatable, case-insensitive)",
    )
    parser.add_argument(
        "--interval",
        type=int,
        default=0,
        help="seconds between scans; 0 or --once scans once",
    )
    parser.add_argument("--once", action="store_true", help="scan once and exit")
    parser.add_argument(
        "--dry-run",
        action="store_true",
        help="print what would be filed without mutating the document",
    )
    parser.add_argument(
        "--list",
        action="store_true",
        help="print the live agent-doc session table and exit",
    )
    args = parser.parse_args()

    if args.list:
        for doc in live_session_docs():
            root = find_project_root(doc)
            policy = dogfood_policy(doc)
            status = "enabled" if policy is not None and policy.enabled else "off"
            print(f"{status:9} {doc}  (root: {root})")
        return 0

    if args.once or args.interval <= 0:
        scan_once(args)
        return 0

    while True:
        try:
            scan_once(args)
        except KeyboardInterrupt:
            return 0
        except Exception as exc:  # noqa: BLE001 - daemon survives transient boundary failures
            print(f"[error] scan failed: {exc}", file=sys.stderr)
        time.sleep(args.interval)


if __name__ == "__main__":
    sys.exit(main())
