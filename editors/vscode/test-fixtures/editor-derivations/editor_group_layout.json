{
  "derivation": "editor_group_layout",
  "about": "#vscodeupgradelayout parity cases. The Rust `editor_group_layout` derivation (agent-doc-editor-surface group_layout.rs, answered through agent_doc_editor_derive_json) and the VS Code extension's frozen TypeScript floor (groupLayout.ts, groupLayout.test.ts) both answer every case. A native rule change updates `expected`; the floor may then diverge only through an explicit per-case `floor_expected`.",
  "cases": [
    {
      "name": "two side-by-side groups are two measured columns",
      "input": {
        "layout": {
          "orientation": 0,
          "groups": [
            {
              "size": 600
            },
            {
              "size": 600
            }
          ]
        },
        "group_count": 2,
        "editors": [
          {
            "view_column": 1,
            "file": "tasks/a.md"
          },
          {
            "view_column": 2,
            "file": "tasks/b.md"
          }
        ],
        "focused_group": 0
      },
      "expected": {
        "columns": [
          [
            "tasks/a.md"
          ],
          [
            "tasks/b.md"
          ]
        ],
        "column_order": "editor",
        "source": "measured",
        "orientation": "h",
        "position": "left",
        "reason": null,
        "observed_line": "[layout-detect] vscode groups=2 layout_groups=2 source=measured orientation=h columns=2 [tasks/a.md | tasks/b.md] order=editor"
      }
    },
    {
      "name": "a vertical split is one column stacked top to bottom",
      "input": {
        "layout": {
          "orientation": 1,
          "groups": [
            {
              "size": 400
            },
            {
              "size": 400
            }
          ]
        },
        "group_count": 2,
        "editors": [
          {
            "view_column": 2,
            "file": "tasks/b.md"
          },
          {
            "view_column": 1,
            "file": "tasks/a.md"
          }
        ],
        "focused_group": 1
      },
      "expected": {
        "columns": [
          [
            "tasks/a.md",
            "tasks/b.md"
          ]
        ],
        "column_order": "editor",
        "source": "measured",
        "orientation": "v",
        "position": "bottom",
        "reason": null,
        "observed_line": "[layout-detect] vscode groups=2 layout_groups=2 source=measured orientation=v columns=1 [tasks/a.md,tasks/b.md] order=editor"
      }
    },
    {
