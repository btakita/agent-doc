{
  "derivation": "remote_layout",
  "about": "GH #326 phase 4 contract cases. The Rust `remote_layout` derivation (the GH #134 Remote Dev fold, agent-doc-editor-surface-io) answers every case, folding its steps in order from an empty memory with no controller authority. The plugin has no Kotlin copy of this fold: its memoryless fallback was retired in phase 4, so with no native answer the layout is unknown. LayoutDetectorTest pins that the plugin sends each step's `input` exactly and turns each `expected` answer into the layout it publishes. A native rule change updates this file.",
  "cases": [
    {
      "name": "one client's visible editors are a detected split",
      "steps": [
        {
          "input": {
            "project_root": "/repo",
            "clients": [
              {
                "visible": [
                  "tasks/left.md",
                  "tasks/right.md"
                ],
                "selected": [
                  "tasks/left.md"
                ],
                "open": [
                  "tasks/left.md",
                  "tasks/right.md"
                ]
              }
            ],
            "focused": [
              "tasks/left.md"
            ]
          },
          "expected": {
            "columns": [
              {
                "files": [
                  "tasks/left.md"
                ]
              },
              {
                "files": [
                  "tasks/right.md"
                ]
              }
            ],
            "source": "remote_client_visible_editors",
            "column_order": "unknown"
          }
        }
      ]
    },
    {
      "name": "one client selecting two files is still a detected split, duplicates dropped",
      "steps": [
        {
          "input": {
            "project_root": "/repo",
            "clients": [
              {
                "visible": [],
                "selected": [
                  "tasks/laptop.md",
                  "tasks/1099.md",
                  "tasks/laptop.md"
                ],
                "open": [
                  "tasks/laptop.md",
                  "tasks/1099.md"
                ]
              }
            ],
            "focused": [
              "tasks/laptop.md"
            ]
          },
          "expected": {
            "columns": [
              {
                "files": [
                  "tasks/laptop.md"
                ]
              },
              {
                "files": [
                  "tasks/1099.md"
                ]
              }
            ],
            "source": "remote_client_selected_files",
            "column_order": "unknown"
          }
        }
      ]
    },
    {
      "name": "a focused file without client split evidence is unknown",
      "steps": [
        {
          "input": {
            "project_root": "/repo",
            "clients": [
              {
                "visible": [],
                "selected": [
                  "tasks/laptop.md"
                ],
                "open": [
                  "tasks/laptop.md"
                ]
              }
            ],
            "focused": [
              "tasks/laptop.md"
            ]
          },
          "expected": {
            "columns": [],
            "source": "unknown",
            "column_order": "unknown",
            "reason": "no_split_evidence"
          }
        }
      ]
    },
