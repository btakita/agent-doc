{
  "derivation": "registration_projection",
  "about": "GH #326 phase 5 parity cases. The Rust `registration_projection` derivation (agent-doc-editor-surface-io) and the plugin's frozen Kotlin floor (RegistrationProjectionTest) both answer every case. `texts` are the three generations the plugin holds (null: unavailable); the plugin turns them into the presence and equality facts in `input`, which is all the derivation sees, and the Kotlin test checks that capture. The frozen floor decides from `texts`; the derivation decides from `input`. A native rule change updates this file and may diverge from the frozen floor only on purpose.",
  "cases": [
    {
      "name": "a fresh-controller reseed publishes a proven live buffer instead of the temporary empty canonical",
      "texts": {
        "published_shadow": "# Session\n\n<!-- agent:queue -->\n<!-- /agent:queue -->\n",
        "buffer": "# Session\n\n<!-- agent:queue -->\n- operator prompt\n<!-- /agent:queue -->\n",
        "canonical": ""
      },
      "input": {
        "defer_canonical_projection_for_pending_local": false,
        "canonical_projection_retained": false,
        "retained_replica_reseed_pending": true,
        "canonical_covers_retained_frontier": null,
        "has_published_shadow": true,
        "has_buffer": true,
        "has_canonical": true,
        "buffer_equals_canonical": false,
        "buffer_equals_shadow": false,
        "canonical_equals_shadow": false,
        "canonical_contains_operator_edits": null,
        "clean_merge_available": null
      },
      "expected": {
        "action": "publish_operator_buffer",
        "hold_reason": null
      }
    },
    {
      "name": "a fresh-controller reseed without a settled ancestor holds with its own reason",
