              "files": [
                "/repo/tasks/b.md"
              ]
            }
          ],
          "column_order": "editor"
        },
        "columns": [
          "/repo/tasks/a.md",
          "/repo/tasks/b.md"
        ],
        "column_order": "editor",
        "decision": "publish"
      }
    },
    {
      "name": "rootless documents outside the focused root use the workspace base path",
      "input": {
        "base_path": "/repo",
