{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/interop/scenario-v1.schema.json",
  "title": "Lazily interop deterministic scenario v1",
  "type": "object",
  "required": [
    "name",
    "seed",
    "peers",
    "required_features",
    "required_codecs",
    "required_channels",
    "steps",
    "expected_snapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "peers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "peer_id"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "peer_id": {"type": "integer", "minimum": 0}
        }
      }
    },
    "required_codecs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"enum": ["json", "msgpack", "postcard"]}
    },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
            "distributed_crdt",
            "reliable_sync",
            "causal_receipts",
            "signaling",
            "transport_links",
            "stdlib_timer_v1",
            "stdlib_timeout_v1",
            "stdlib_revision_barrier_v1"
        ]
      }
    },
    "required_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "in_process_ffi",
          "shared_memory",
          "ipc_socket",
          "websocket",
          "webrtc_datachannel"
        ]
      }
    },
    "frame_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {"type": "object"}
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
        {
          "type": "object",
          "required": ["op", "channel", "codec", "frame_set"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "transport_matrix"},
            "channel": {
              "enum": [
                "in_process_ffi",
                "shared_memory",
                "ipc_socket",
                "websocket",
                "webrtc_datachannel"
              ]
            },
            "codec": {"enum": ["json", "msgpack", "postcard"]},
            "frame_set": {"type": "string", "minLength": 1},
            "fault": {
              "enum": [
                "split_prefix",
                "split_body",
                "fragment",
                "chunk",
                "backpressure"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "from", "to", "channel", "variant", "codec", "frame_set"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "transport"},
            "from": {"type": "string", "minLength": 1},
            "to": {"type": "string", "minLength": 1},
            "channel": {
              "enum": [
                "in_process_ffi",
                "shared_memory",
                "ipc_socket",
                "websocket",
                "webrtc_datachannel"
              ]
            },
            "variant": {"type": "string", "minLength": 1},
            "codec": {"enum": ["json", "msgpack", "postcard"]},
            "frame_set": {"type": "string", "minLength": 1},
            "fault": {
              "enum": [
                "split_prefix",
                "split_body",
                "fragment",
                "chunk",
                "backpressure"
              ]
            },
            "bidirectional": {"type": "boolean"}
          }
        },
        {
          "type": "object",
            "required": ["op", "peer", "node", "key", "state", "at", "save_as"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "local_set"},
              "peer": {"type": "string"},
              "node": {"type": "integer", "minimum": 0},
              "key": {"type": ["string", "null"]},
              "state": {"type": "object"},
              "at": {"type": "integer", "minimum": 0},
              "save_as": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "required": ["op", "frame", "to", "at", "expect_applied"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "deliver"},
              "frame": {"type": "string", "minLength": 1},
              "to": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "at": {"type": "integer", "minimum": 0},
              "expect_applied": {"type": "integer", "minimum": 0}
            }
          },
        {
          "type": "object",
          "required": ["op", "feature"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "feature_reset"},
            "feature": {
              "enum": [
                "stdlib_timer_v1",
                "stdlib_timeout_v1",
                "stdlib_revision_barrier_v1"
              ]
            }
          }
        },
        {
          "type": "object",
          "required": ["op", "feature", "step", "expected"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "feature_step"},
            "feature": {
              "enum": [
                "stdlib_timer_v1",
                "stdlib_timeout_v1",
                "stdlib_revision_barrier_v1"
              ]
            },
            "step": {"type": "object"},
            "expected": {"type": "object"}
          }
        },
        {
          "type": "object",
          "required": ["op", "feature", "expected"],
          "additionalProperties": false,
          "properties": {
            "op": {"const": "feature_observe"},
            "feature": {
              "enum": [
                "stdlib_timer_v1",
                "stdlib_timeout_v1",
                "stdlib_revision_barrier_v1"
              ]
            },
            "expected": {"type": "object"}
          }
        },
        {
          "type": "object",
          "required": ["op"],
            "additionalProperties": false,
            "properties": {"op": {"const": "assert_converged"}}
          }
        ]
      }
    },
    "expected_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "key", "state"],
        "additionalProperties": false,
        "properties": {
          "node": {"type": "integer", "minimum": 0},
          "key": {"type": ["string", "null"]},
          "state": {"type": "object"}
        }
      }
    }
  }
}
