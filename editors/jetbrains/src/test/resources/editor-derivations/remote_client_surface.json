{
  "derivation": "remote_client_surface",
  "about": "GH #326 phase 4 parity cases. The Rust `remote_client_surface` derivation (agent-doc-editor-surface-io) and the 262/263 backend's frozen Kotlin floor (RemoteClientMeasuredLayoutTest) both answer every case. `nearest_roots` maps a document to its nearest `.agent-doc` project root (absent: none); it stands in for the filesystem. A native rule change updates this file and may diverge from the frozen floor only on purpose.",
  "cases": [
    {
      "name": "a measured split keeps its editor order and preserves focus",
      "input": {
        "base_path": "/repo",
        "fallback_root": "/repo",
        "focused": "/repo/a.md",
        "columns": [
          [
            "/repo/b.md"
          ],
          [
            "/repo/a.md"
          ]
        ]
      },
      "nearest_roots": {
        "/repo/a.md": "/repo",
        "/repo/b.md": "/repo"
      },
      "expected": {
        "project_root": "/repo",
        "surface": {
          "focused": "/repo/a.md",
          "visible": [
            "/repo/b.md",
            "/repo/a.md"
          ],
          "open": [
            "/repo/a.md",
            "/repo/b.md"
          ],
          "columns": [
            {
              "files": [
                "/repo/b.md"
              ]
            },
            {
              "files": [
                "/repo/a.md"
              ]
            }
          ],
          "column_order": "editor",
          "force_reconcile": false,
          "focus_only": false,
          "preserve_focus": true
        }
      }
    },
    {
      "name": "a single-root split addresses that root",
      "input": {
        "base_path": "/repo",
        "fallback_root": "/repo/src/app",
        "focused": "/repo/src/app/tasks/a.md",
        "columns": [
          [
            "/repo/src/app/tasks/a.md"
          ],
          [
            "/repo/src/app/tasks/b.md"
          ]
        ]
      },
      "nearest_roots": {
        "/repo/src/app/tasks/a.md": "/repo/src/app",
        "/repo/src/app/tasks/b.md": "/repo/src/app"
      },
      "expected": {
        "project_root": "/repo/src/app",
        "surface": {
          "focused": "/repo/src/app/tasks/a.md",
          "visible": [
            "/repo/src/app/tasks/a.md",
            "/repo/src/app/tasks/b.md"
          ],
          "open": [
            "/repo/src/app/tasks/a.md",
            "/repo/src/app/tasks/b.md"
          ],
          "columns": [
            {
              "files": [
                "/repo/src/app/tasks/a.md"
              ]
            },
            {
              "files": [
                "/repo/src/app/tasks/b.md"
              ]
            }
          ],
          "column_order": "editor",
          "force_reconcile": false,
          "focus_only": false,
          "preserve_focus": true
        }
      }
    },
    {
