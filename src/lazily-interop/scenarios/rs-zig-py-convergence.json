{
  "name": "rs-zig-py-convergence",
  "seed": 3,
  "peers": [
    {"name": "lazily-rs", "peer_id": 1},
    {"name": "lazily-zig", "peer_id": 2},
    {"name": "lazily-py", "peer_id": 3}
  ],
  "required_features": ["distributed_crdt"],
  "required_codecs": ["json"],
  "required_channels": [],
  "steps": [
    {
      "op": "local_set",
      "peer": "lazily-rs",
      "node": 7,
      "key": null,
      "state": {"Inline": [65]},
      "at": 10,
      "save_as": "rs-write"
    },
    {
      "op": "local_set",
      "peer": "lazily-zig",
      "node": 7,
      "key": null,
      "state": {"Inline": [66]},
      "at": 10,
      "save_as": "zig-write"
    },
    {
      "op": "local_set",
      "peer": "lazily-py",
      "node": 7,
      "key": null,
      "state": {"Inline": [67]},
      "at": 10,
      "save_as": "py-write"
    },
    {
      "op": "deliver",
      "frame": "py-write",
      "to": ["lazily-rs", "lazily-zig"],
      "at": 11,
      "expect_applied": 1
    },
    {
      "op": "deliver",
      "frame": "rs-write",
      "to": ["lazily-py"],
      "at": 11,
      "expect_applied": 1
    },
    {
      "op": "deliver",
      "frame": "zig-write",
      "to": ["lazily-py"],
      "at": 11,
      "expect_applied": 1
    },
    {
      "op": "deliver",
      "frame": "py-write",
      "to": ["lazily-rs"],
      "at": 12,
      "expect_applied": 0
    },
    {"op": "assert_converged"}
  ],
  "expected_snapshot": [
    {"node": 7, "key": null, "state": {"Inline": [67]}}
  ]
}
