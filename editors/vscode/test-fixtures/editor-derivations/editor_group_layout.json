            "view_column": 2,
            "file": "b.md"
          },
          {
            "view_column": 3,
            "file": "c.md"
          }
        ],
        "focused_group": 2
      },
      "expected": {
        "columns": [
          [
            "a.md"
          ],
          [
            "b.md",
            "c.md"
          ]
        ],
        "column_order": "editor",
        "source": "measured",
        "orientation": "h",
        "position": "right",
        "reason": null,
        "observed_line": "[layout-detect] vscode groups=3 layout_groups=3 source=measured orientation=h columns=2 [a.md | b.md,c.md] order=editor"
      }
    },
