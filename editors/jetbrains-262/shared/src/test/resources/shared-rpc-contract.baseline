# GH #435: the frozen Fleet RPC wire contract between the JetBrains Client frontend and the
# backend (SharedRpcContractGuardTest). Every shipped Client shell keeps calling these methods and
# decoding these messages with `ignoreUnknownKeys = false`, so a backend must keep serving them.
#
# To change it: prefer a new, additive RemoteApi. Otherwise replace the fingerprint below with
# shared/build/shared-rpc-contract.actual, bump `revision`, set `shell_bump` to the plugin version
# that ships the change, and state the `compatibility_plan` for Clients and backends in the field.
revision: 1
shell_bump: 0.2.1055
compatibility_plan: SurfaceSnapshotRpcApi keeps its exact shipped shape (0.2.1046 methods plus the 0.2.1052 frontendImplementationReleaseIdentity), so every Client from 0.2.1046 on calls a backend that answers all of its methods; the backend answers the identity poll and the whole-package poll only for a Client its release delivery gate admits. The new FrontendReleaseRpcApi is additive: a 0.2.1054-or-older backend fails its call and a 0.2.1055 Client falls back to the frozen frontendImplementationRelease at most once per 10 minutes; a 0.2.1054-or-older Client never calls it.
---
api com.github.btakita.agentdoc.split.FrontendReleaseRpcApi
  frontendReleaseOffer(client: com.github.btakita.agentdoc.split.FrontendClientBuild): com.github.btakita.agentdoc.split.FrontendReleaseOffer
api com.github.btakita.agentdoc.split.SurfaceSnapshotRpcApi
  frontendImplementationRelease(): com.github.btakita.agentdoc.split.FrontendImplementationRelease?
  frontendImplementationReleaseIdentity(): com.github.btakita.agentdoc.split.FrontendImplementationReleaseIdentity?
  openIngress(projectId: com.intellij.platform.project.ProjectId, frontendInstanceId: kotlin.String): Flow<com.github.btakita.agentdoc.split.SurfaceIngressLease>
  publishPresentationReceipt(lease: com.github.btakita.agentdoc.split.SurfaceIngressLease, receipt: com.github.btakita.agentdoc.split.FrontendPresentationReceipt): com.github.btakita.agentdoc.split.SurfaceIngressAck
  publishSnapshot(lease: com.github.btakita.agentdoc.split.SurfaceIngressLease, snapshot: com.github.btakita.agentdoc.split.FrontendSurfaceSnapshot): com.github.btakita.agentdoc.split.SurfaceIngressAck
  supportedSnapshotSchemaVersion(): kotlin.Int
