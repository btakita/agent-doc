    {"op": "deliver", "frame": "go-write", "to": ["lazily-cpp"], "at": 51, "expect_applied": 1},
    {"op": "deliver", "frame": "cpp-write", "to": ["lazily-rs"], "at": 52, "expect_applied": 0},
    {"op": "assert_converged"}
