<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="agent.doc.shared"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.btakita.agentdoc.split.frontend.SurfaceSnapshotFrontendActivity"/>
        <fileEditorProvider implementation="com.github.btakita.agentdoc.split.frontend.DetachedPlaceholderFileEditorProvider"/>
    </extensions>
</idea-plugin>
