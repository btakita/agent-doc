{
  "derivation": "sync_layout",
  "about": "GH #326 phase 3 parity cases, extended in phase 3b (`chosen_root` input; `layout_mode` and `candidate_roots` outputs). The Rust `sync_layout` derivation (agent-doc-editor-surface-io) and the plugin's frozen Kotlin floor (SyncLayoutSnapshotTest) both answer every case. `nearest_roots` maps a visible document to its nearest `.agent-doc` project root (absent: none); it stands in for the filesystem. A native rule change updates this file and may diverge from the frozen floor only on purpose.",
  "cases": [
    {
      "name": "a single-root split stays scoped to that root and publishes absolute columns",
      "input": {
        "base_path": "/repo",
        "fallback_root": "/repo/src/app",
        "focused": "/repo/src/app/tasks/a.md",
        "visible": [
          "/repo/src/app/tasks/a.md",
          "/repo/src/app/tasks/b.md"
        ],
        "layout": {
          "columns": [
            {
              "files": [
                "src/app/tasks/a.md"
              ]
            },
            {
              "files": [
                "src/app/tasks/b.md"
              ]
            }
          ],
          "column_order": "editor"
        }
      },
      "nearest_roots": {
        "/repo/src/app/tasks/a.md": "/repo/src/app",
        "/repo/src/app/tasks/b.md": "/repo/src/app"
      },
      "expected": {
        "project_root": "/repo/src/app",
        "layout": {
          "columns": [
            {
              "files": [
                "/repo/src/app/tasks/a.md"
              ]
            },
            {
              "files": [
                "/repo/src/app/tasks/b.md"
              ]
            }
          ],
          "column_order": "editor"
        },
        "columns": [
          "/repo/src/app/tasks/a.md",
          "/repo/src/app/tasks/b.md"
        ],
        "column_order": "editor",
        "decision": "publish",
        "layout_mode": "exact",
        "candidate_roots": [
          "/repo/src/app",
          "/repo"
        ]
      }
    },
    {
      "name": "a cross-root split uses the workspace root",
      "input": {
        "base_path": "/repo",
        "fallback_root": "/repo/src/app",
        "focused": "/repo/src/app/tasks/y.md",
        "visible": [
          "/repo/src/app/tasks/y.md",
          "/repo/tasks/x.md"
        ],
        "layout": {
          "columns": [
            {
              "files": [
                "tasks/x.md"
              ]
            },
            {
              "files": [
                "src/app/tasks/y.md"
              ]
            }
          ],
          "column_order": "editor"
        }
      },
      "nearest_roots": {
        "/repo/src/app/tasks/y.md": "/repo/src/app",
        "/repo/tasks/x.md": "/repo"
      },
      "expected": {
        "project_root": "/repo",
        "layout": {
          "columns": [
            {
              "files": [
                "/repo/tasks/x.md"
              ]
            },
            {
              "files": [
                "/repo/src/app/tasks/y.md"
              ]
            }
          ],
          "column_order": "editor"
        },
        "columns": [
          "/repo/tasks/x.md",
          "/repo/src/app/tasks/y.md"
        ],
        "column_order": "editor",
        "decision": "publish",
        "layout_mode": "exact",
        "candidate_roots": [
          "/repo/src/app",
          "/repo"
        ]
      }
    },
    {
      "name": "a nested root keeps a workspace document absolute and passes the order label through",
