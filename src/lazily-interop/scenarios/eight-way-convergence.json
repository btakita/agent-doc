    {"op": "local_set", "peer": "lazily-cpp", "node": 7, "key": null, "state": {"Inline": [72]}, "at": 50, "save_as": "cpp-write"},
    {"op": "deliver", "frame": "cpp-write", "to": ["lazily-rs", "lazily-zig", "lazily-py", "lazily-kt", "lazily-js", "lazily-dart", "lazily-go"], "at": 51, "expect_applied": 1},
