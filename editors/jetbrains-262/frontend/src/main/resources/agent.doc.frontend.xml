<idea-plugin>
    <dependencies>
        <module name="intellij.platform.frontend"/>
        <module name="agent.doc.shared"/>
        <plugin id="org.jetbrains.plugins.terminal"/>
    </dependencies>

    <extensions defaultExtensionNs="com.intellij">
        <postStartupActivity implementation="com.github.btakita.agentdoc.split.frontend.SurfaceSnapshotFrontendActivity"/>
        <fileEditorProvider implementation="com.github.btakita.agentdoc.split.frontend.DetachedPlaceholderFileEditorProvider"/>
        <!-- GH #391: soft wraps are laid out in this process, so the Markdown wrap fix lives here.
             The language is named by id; this module needs no Markdown plugin dependency. -->
        <lang.lineWrapStrategy language="Markdown" order="first"
                               implementationClass="com.github.btakita.agentdoc.split.frontend.MarkdownBracketWrapStrategy"/>
    </extensions>

    <!-- UpdateSettings is process-local. Keep this action in the JetBrains Client process so a
         Remote Dev backend cannot report success after changing only its own repository list. -->
    <actions>
        <action id="AgentDoc.UpdateChannel"
                class="com.github.btakita.agentdoc.split.frontend.FrontendAgentDocUpdateChannelAction"
                text="Enable Agent Doc GitHub Updates"
                description="Toggle the compatibility-matched Agent Doc GitHub update repository in this JetBrains Client">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
