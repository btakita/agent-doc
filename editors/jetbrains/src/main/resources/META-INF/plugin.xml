<idea-plugin require-restart="false">
    <id>com.github.btakita.agent-doc</id>
    <name>Agent Doc</name>
    <vendor url="https://github.com/btakita">btakita</vendor>
    <description><![CDATA[
        Submit markdown documents to AI agents via agent-doc.

        Press a hotkey to route <code>agent-doc path/to/file.md</code> to the correct
        agent session via tmux. Supports multiple concurrent sessions —
        each document routes to its own tmux pane based on the session UUID
        in the YAML frontmatter.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <notificationGroup id="Agent Doc"
                           displayType="TOOL_WINDOW"
                           isLogByDefault="true"/>
        <completion.contributor language="any"
                                implementationClass="com.github.btakita.agentdoc.SlashCommandCompletionContributor"/>
        <applicationService serviceImplementation="com.github.btakita.agentdoc.AgentDocColorSettings"/>
        <applicationConfigurable parentId="tools"
                                 id="com.github.btakita.agentdoc.colorConfigurable"
                                 instance="com.github.btakita.agentdoc.AgentDocColorConfigurable"
                                 displayName="Agent Doc Colors"/>
        <applicationService serviceImplementation="com.github.btakita.agentdoc.MarkdownStyleSettings"/>
        <applicationConfigurable parentId="tools"
                                 id="com.github.btakita.agentdoc.markdownStyleConfigurable"
                                 instance="com.github.btakita.agentdoc.MarkdownStyleConfigurable"
                                 displayName="Agent Doc Markdown Style"/>
    </extensions>

    <projectListeners>
        <listener class="com.github.btakita.agentdoc.PluginLifecycleListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </projectListeners>

    <actions>
        <action id="AgentDoc.Popup"
                class="com.github.btakita.agentdoc.AgentDocPopupAction"
                text="Agent Doc Actions"
                description="Show Agent Doc actions for the current markdown file">
            <keyboard-shortcut first-keystroke="alt SPACE" keymap="$default"/>
        </action>
        <action id="AgentDoc.Submit"
                class="com.github.btakita.agentdoc.SubmitAction"
                text="Run Agent Doc"
                description="Route agent-doc command to the correct agent session via tmux">
            <keyboard-shortcut first-keystroke="ctrl shift alt A" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.FixDocument"
                class="com.github.btakita.agentdoc.FixDocumentAction"
                text="Fix Document"
                description="Run agent-doc fix for the current markdown document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.RunWithJunie"
                class="com.github.btakita.agentdoc.RunWithJunieAction"
                text="Run with Junie"
                description="Run agent-doc via the Junie agent">
            <keyboard-shortcut first-keystroke="ctrl shift alt J" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.Claim"
                class="com.github.btakita.agentdoc.ClaimAction"
                text="Claim for Tmux Pane"
                description="Claim this document for the currently active tmux pane">
            <keyboard-shortcut first-keystroke="ctrl shift alt C" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.CompactExchange"
                class="com.github.btakita.agentdoc.CompactExchangeAction"
                text="Compact Exchange"
                description="Compact the exchange component for this document and commit the result">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.ForceClaim"
                class="com.github.btakita.agentdoc.ForceClaimAction"
                text="Force Claim for Tmux Pane"
                description="Force-claim this document, overriding existing pane bindings">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.SyncLayout"
                class="com.github.btakita.agentdoc.SyncLayoutAction"
                text="Sync Tmux Layout"
                description="Re-sync tmux pane layout to match the current editor split">
            <keyboard-shortcut first-keystroke="ctrl shift alt L" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.LoadTmuxWindow"
                class="com.github.btakita.agentdoc.LoadTmuxWindowAction"
                text="Load Tmux Window"
                description="Load (autostart) the tmux window for the focused agent-doc document on demand">
            <keyboard-shortcut first-keystroke="ctrl shift alt W" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.ShowSessionStatus"
                class="com.github.btakita.agentdoc.ShowSessionStatusAction"
                text="Show Session Status"
                description="Show the authoritative agent-doc session status for this document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.RestartSupervisorProcess"
                class="com.github.btakita.agentdoc.RestartSupervisorProcessAction"
                text="Restart Supervisor Process"
                description="Restart the bound agent-doc supervisor process for this document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.RestartAgent"
                class="com.github.btakita.agentdoc.RestartAgentAction"
                text="Restart Agent"
                description="Restart the agent harness for this document (reloads a changed `agent:` frontmatter)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.StopAgent"
                class="com.github.btakita.agentdoc.StopAgentAction"
                text="Stop Agent"
                description="Stop the agent harness for this document (the supervisor stays running; use Restart Agent to bring it back)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.CancelTurn"
                class="com.github.btakita.agentdoc.CancelTurnAction"
                text="Cancel Turn"
                description="Cancel the currently running turn (no-op if the agent is idle, so it never closes the agent)">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.KillSupervisor"
                class="com.github.btakita.agentdoc.KillSupervisorAction"
                text="Kill Supervisor"
                description="Kill the supervisor process for this document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.ClearSessionContext"
                class="com.github.btakita.agentdoc.ClearSessionContextAction"
                text="Clear Session Context"
                description="Send /clear to the bound agent-doc session for this document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.InterruptClearSessionContext"
                class="com.github.btakita.agentdoc.InterruptClearSessionContextAction"
                text="Interrupt and Clear Session Context"
                description="Interrupt the bound agent-doc session, then clear its context">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.CopySessionDiagnostics"
                class="com.github.btakita.agentdoc.CopySessionDiagnosticsAction"
                text="Copy Session Diagnostics"
                description="Copy the current agent-doc session diagnostics for this document">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.RefreshEnvironment"
                class="com.github.btakita.agentdoc.RefreshEnvironmentAction"
                text="Refresh Agent Doc Environment"
                description="Clears slash command cache and forces VFS rescan of .claude/ dirs">
            <keyboard-shortcut first-keystroke="ctrl shift alt R" keymap="$default"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.ResyncFixSessions"
                class="com.github.btakita.agentdoc.ResyncFixSessionsAction"
                text="Resync / Fix Sessions"
                description="Run agent-doc resync --fix to repair stale routing/registry state and reap dead panes">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
        <action id="AgentDoc.GcStaleSessions"
                class="com.github.btakita.agentdoc.GcStaleSessionsAction"
                text="GC Stale Sessions"
                description="Run agent-doc gc to reap orphaned panes and prune stale startup/diagnostic state">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
            <add-to-group group-id="ProjectViewPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
