{
  "enabledPlugins": {
    "claude-mem@thedotmack": true,
    "frontend-design@claude-plugins-official": true
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "agent-doc hook coined-id-pre-tool-use",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "agent-doc turn-status idle",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "tmux set-option -p pane-border-style 'fg=colour226' 2>/dev/null; tmux set-option -pu pane-active-border-style 2>/dev/null",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "agent-doc turn-status idle",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "tmux set-option -p pane-border-style 'fg=colour39' 2>/dev/null; tmux set-option -pu pane-active-border-style 2>/dev/null",
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "agent-doc turn-status active",
            "type": "command"
          }
        ]
      }
    ]
  },
  "model": "sonnet",
  "permissions": {
    "defaultMode": "bypassPermissions"
  }
}