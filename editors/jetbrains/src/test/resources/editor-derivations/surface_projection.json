{
  "derivation": "surface_projection",
  "about": "GH #326 phase 2 parity cases. The Rust `surface_projection` derivation (agent-doc-editor-surface-io) and the plugin's frozen Kotlin floor (SurfaceProjectionTest) both answer every case. `remote_resolution` is the compatibility answer for a case whose layout is remote. A native rule change updates this file and may diverge from the frozen floor only on purpose.",
  "cases": [
    {
      "name": "a two-window split publishes absolute columns with proximity-ordered open tabs",
      "input": {
        "base_path": "/repo",
        "remote": {
          "project_root": "/repo",
          "clients": [],
          "focused": []
        },
        "backend_window_count": 2,
        "windows": [
          {
            "x": 0,
            "y": 0,
            "selected": "/repo/a.md",
            "session_tabs": [
              "/repo/a.md",
              "/repo/c.md"
            ]
          },
          {
            "x": 640,
            "y": 0,
            "selected": "/repo/b.md",
            "session_tabs": [
              "/repo/b.md"
            ]
          }
        ],
        "history": [],
        "manager_selected": [
          "/repo/b.md"
        ],
        "open_session_documents": [
          "/repo/a.md",
          "/repo/b.md",
          "/repo/c.md",
          "/repo/d.md"
        ],
        "anchor_selected_session": "/repo/b.md",
        "selected_text_editor_session": "/repo/b.md",
        "preferred": "/repo/b.md",
        "preferred_session_document": true,
        "authority": "document_selection",
        "remaining_selection_passes": 3
      },
      "expected": {
        "outcome": "ready",
        "reason": null,
        "layout_source": "windows",
        "surface": {
          "focused": "/repo/b.md",
          "visible": [
            "/repo/a.md",
            "/repo/b.md"
          ],
          "open": [
            "/repo/b.md",
            "/repo/a.md",
            "/repo/c.md"
          ],
          "columns": [
            {
              "files": [
                "/repo/a.md"
              ]
            },
            {
              "files": [
                "/repo/b.md"
              ]
            }
          ],
          "column_order": "editor",
          "force_reconcile": false,
          "focus_only": false,
          "preserve_focus": false
        }
      }
    },
    {
      "name": "a restored window without a selection defers",
      "input": {
        "base_path": "/repo",
        "remote": {
          "project_root": "/repo",
          "clients": [],
          "focused": []
        },
        "backend_window_count": 2,
        "windows": [
          {
            "x": 0,
            "y": 0,
            "selected": "/repo/a.md",
            "session_tabs": [
              "/repo/a.md"
            ]
          },
          {
            "x": 640,
            "y": 0,
            "session_tabs": [
              "/repo/b.md"
            ]
          }
        ],
        "open_session_documents": [
          "/repo/a.md",
          "/repo/b.md"
        ]
      },
      "expected": {
        "outcome": "deferred",
        "reason": "backend_window_selection_incomplete windows=2 selected=2",
        "layout_source": "none",
        "surface": null
      }
    },
