  "required_features": ["distributed_crdt"],
  "required_codecs": [],
  "required_channels": [],
  "steps": [
    {"op": "local_set", "peer": "lazily-rs", "node": 7, "key": null, "state": {"Inline": [65]}, "at": 10, "save_as": "rs-write"},
    {"op": "local_set", "peer": "lazily-zig", "node": 7, "key": null, "state": {"Inline": [66]}, "at": 10, "save_as": "zig-write"},
    {"op": "local_set", "peer": "lazily-py", "node": 7, "key": null, "state": {"Inline": [67]}, "at": 10, "save_as": "py-write"},
    {"op": "local_set", "peer": "lazily-kt", "node": 7, "key": null, "state": {"Inline": [68]}, "at": 10, "save_as": "kt-write"},
    {"op": "local_set", "peer": "lazily-js", "node": 7, "key": null, "state": {"Inline": [69]}, "at": 20, "save_as": "js-write"},
    {"op": "local_set", "peer": "lazily-dart", "node": 7, "key": null, "state": {"Inline": [70]}, "at": 30, "save_as": "dart-write"},
