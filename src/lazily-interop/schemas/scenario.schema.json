{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lazily.dev/interop/scenario-v1.schema.json",
  "title": "Lazily interop deterministic scenario v1",
  "type": "object",
  "required": [
    "name",
    "seed",
    "peers",
    "required_features",
    "required_codecs",
    "required_channels",
    "steps",
    "expected_snapshot"
  ],
  "additionalProperties": false,
  "properties": {
    "name": {"type": "string", "minLength": 1},
    "seed": {"type": "integer", "minimum": 0},
    "peers": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": ["name", "peer_id"],
        "additionalProperties": false,
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "peer_id": {"type": "integer", "minimum": 0}
        }
      }
    },
    "required_codecs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["json", "msgpack", "postcard"]}
    },
    "required_features": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "distributed_crdt",
          "reliable_sync",
          "causal_receipts",
          "signaling",
          "transport_links"
        ]
      }
    },
    "required_channels": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "in_process_ffi",
          "shared_memory",
          "ipc_socket",
          "websocket",
          "webrtc_datachannel"
        ]
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["op", "peer", "node", "key", "state", "at", "save_as"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "local_set"},
              "peer": {"type": "string"},
              "node": {"type": "integer", "minimum": 0},
              "key": {"type": ["string", "null"]},
              "state": {"type": "object"},
              "at": {"type": "integer", "minimum": 0},
              "save_as": {"type": "string", "minLength": 1}
            }
          },
          {
            "type": "object",
            "required": ["op", "frame", "to", "at", "expect_applied"],
            "additionalProperties": false,
            "properties": {
              "op": {"const": "deliver"},
              "frame": {"type": "string", "minLength": 1},
              "to": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {"type": "string", "minLength": 1}
              },
              "at": {"type": "integer", "minimum": 0},
              "expect_applied": {"type": "integer", "minimum": 0}
            }
          },
          {
            "type": "object",
            "required": ["op"],
            "additionalProperties": false,
            "properties": {"op": {"const": "assert_converged"}}
          }
        ]
      }
    },
    "expected_snapshot": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["node", "key", "state"],
        "additionalProperties": false,
        "properties": {
          "node": {"type": "integer", "minimum": 0},
          "key": {"type": ["string", "null"]},
          "state": {"type": "object"}
        }
      }
    }
  }
}
